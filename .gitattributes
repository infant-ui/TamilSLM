*.pdf filter=lfs diff=lfs merge=lfs -text

# Production ingestion pipeline's binary outputs (data/processed/cache and
# data/processed/embeddings): grows on every reindex/re-embed, and was found
# to be committed as plain git blobs (not LFS) despite LFS already being
# configured and authenticated for this remote -- PR #2's LFS additions cover
# research/** only, a different directory tree, so this gap predates and is
# independent of that PR. Applies to files added/re-added from now on; the
# copies already in history (including the Phase 1 chunk-id/encoder rebuild)
# are NOT retroactively migrated by this rule -- that needs
# `git lfs migrate import` plus a force-push, a history rewrite that needs
# explicit sign-off before running, not something to do unprompted.
data/processed/cache/*.npy filter=lfs diff=lfs merge=lfs -text
data/processed/cache/*.pkl filter=lfs diff=lfs merge=lfs -text
data/processed/embeddings/**/*.npy filter=lfs diff=lfs merge=lfs -text
