# GPU Server Credentials - Copy this file to .env and fill in your values
# DO NOT put real credentials in this file!
GPU_SERVER_HOST=your_server_ip_here
GPU_SERVER_PORT=22
GPU_SERVER_USER=your_username_here
GPU_SERVER_PASSWORD=your_password_here

# ── docker-compose stack configuration ──
# Copy this file to .env at the repo root and fill in real values before running
# `docker-compose up`. None of these have working defaults baked into the code
# anymore -- services fail closed (401 / refuse to start) rather than falling back
# to a shared "dev" secret if these are left unset.

# Redis requires a password; docker-compose will refuse to start Redis without one.
REDIS_PASSWORD=change-me-to-a-long-random-value

# Per-service admin keys (gate sensitive/admin-only routes). Generate with e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"` -- use a different
# value for each key, and keep them out of version control.
GENERATION_ADMIN_KEY=change-me-generation-admin-key
RETRIEVAL_ADMIN_KEY=change-me-retrieval-admin-key
CORRECTION_ADMIN_KEY=change-me-correction-admin-key

# Comma-separated list of origins allowed to call the backend services via CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Where the browser (not other containers) should reach the gateway. Baked into the
# frontend's static bundle at build time.
REACT_APP_GATEWAY_URL=http://localhost:5000

# NVIDIA NIM image generation (see backend/generation-service/.env.example for details)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/images/generations
NVIDIA_IMAGE_MODEL=alibaba/qwen-image
